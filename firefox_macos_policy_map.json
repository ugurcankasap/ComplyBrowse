{
    "schema_version": "1.0",
    "browser": "Firefox",
    "platform": "macOS",
    "derived_from": "firefox_cis_policy_map.json",
    "derivation_rule": "control_id and policy_key are carried over unchanged from the Windows map. Only macOS channel information is added. This file never overrides the Windows map.",
    "preference_domain": "org.mozilla.firefox",

    "channels": {
        "policies_json": {
            "id": "POLICIES_JSON",
            "description": "Enterprise policy file shipped inside the Firefox application bundle.",
            "bundle_relative_path": "Contents/Resources/distribution/policies.json",
            "root_key": "policies",
            "enforced": true,
            "layer": "L1"
        },
        "plist": {
            "id": "PLIST",
            "description": "Preference-domain policies delivered as a configuration profile by an MDM, or written directly into the preference domain.",
            "preference_domain": "org.mozilla.firefox",
            "gate": {
                "key": "EnterprisePoliciesEnabled",
                "required_value": true,
                "note": "Firefox reads policies from the preference domain only when this key is present and true. Without it the plist channel is inactive even if policy keys exist in the domain."
            },
            "key_layout": "Policy keys sit at the top level of the domain, with no 'policies' wrapper. Nested policies are dictionaries with the same member names as policies.json.",
            "scopes": [
                {
                    "id": "MANAGED",
                    "root": "/Library/Managed Preferences",
                    "also_scan_user_subdirectories": true,
                    "enforced": true,
                    "layer": "L1",
                    "note": "MDM-delivered configuration profiles land here and shadow every lower scope."
                },
                {
                    "id": "SYSTEM",
                    "root": "/Library/Preferences",
                    "enforced": false,
                    "layer": "L2",
                    "note": "Machine-wide but locally writable by an administrator; not proof of managed enforcement."
                },
                {
                    "id": "USER",
                    "root": "~/Library/Preferences",
                    "enforced": false,
                    "layer": "L2",
                    "note": "User-revertible."
                }
            ]
        },
        "profile_preferences": {
            "id": "PROFILE_PREFS",
            "description": "Per-profile user configuration; never enforced.",
            "evidence_files": [
                "prefs.js",
                "user.js"
            ],
            "enforced": false,
            "layer": "L2"
        }
    },

    "channel_precedence": {
        "model": "PROVIDER_EXCLUSIVE",
        "winner": "PLIST",
        "order": [
            "PLIST",
            "POLICIES_JSON"
        ],
        "rule": "Firefox selects one policy provider for the whole policy set, it does not merge them. On macOS the preference-domain provider is offered first: when EnterprisePoliciesEnabled is true in org.mozilla.firefox, every policy value comes from the preference domain and policies.json is not read at all, including for keys the plist does not define. Only when the gate is absent or false does the policies.json provider apply.",
        "granularity": "The winner is decided once per endpoint, not per control. A control absent from the winning provider is unconfigured, even when the losing provider defines it.",
        "within_plist_channel": {
            "order": [
                "MANAGED",
                "SYSTEM",
                "USER"
            ],
            "rule": "CFPreferences resolution: a value in /Library/Managed Preferences shadows the same key in every lower scope."
        },
        "conflict_handling": {
            "report_both": true,
            "effective_channel_field": "effective_channel",
            "conflict_flag": "channel_conflict",
            "verdict_source": "The verdict is decided by the effective channel only. The losing channel is recorded as context and never changes the verdict.",
            "note": "A value present only in the losing channel is reported as a deployment defect (configured but not in force), not as compliance."
        },
        "unreadable_channel": {
            "result": "NOT_ASSESSED",
            "root_cause": "RC_TCC_PERMISSION_MISSING",
            "rule": "If the gate key cannot be read, the winning provider is unknown and the control is not assessed rather than failed."
        }
    },

    "discovery": {
        "rule": "No fixed path is embedded in the collector. Every path below is a candidate that must be probed in the given order, and the path that produced a value is recorded with the evidence.",
        "order": [
            "application_bundle",
            "policies_json",
            "profiles_ini",
            "profiles"
        ],
        "application_bundle": {
            "candidate_paths": [
                "/Applications/Firefox.app",
                "/Applications/Firefox Developer Edition.app",
                "/Applications/Firefox Nightly.app",
                "/Applications/Firefox ESR.app",
                "~/Applications/Firefox.app",
                "~/Applications/Firefox Developer Edition.app",
                "~/Applications/Firefox Nightly.app",
                "/Applications/Utilities/Firefox.app",
                "/opt/homebrew-cask/Caskroom/firefox/Firefox.app"
            ],
            "resolve_from_running_process": true,
            "process_pattern": "(?i)firefox",
            "process_path_to_bundle": "Strip the /Contents/MacOS/<binary> suffix from the running executable path to obtain the bundle, so a bundle in a non-standard location is still discovered.",
            "version_plist_relative_path": "Contents/Info.plist",
            "scan_all_matches": true,
            "note": "Every candidate that exists is inspected. Multiple installed bundles are all reported; the running bundle is listed first when it can be resolved."
        },
        "policies_json": {
            "bundle_relative_path": "Contents/Resources/distribution/policies.json",
            "root_key": "policies",
            "note": "Resolved against each discovered bundle, never against a hardcoded /Applications path."
        },
        "profiles_ini": {
            "candidate_paths": [
                "~/Library/Application Support/Firefox/profiles.ini",
                "~/Library/Application Support/Firefox Developer Edition/profiles.ini",
                "~/Library/Application Support/Firefox Nightly/profiles.ini"
            ],
            "section_keys": {
                "path": "Path",
                "is_relative": "IsRelative",
                "default": "Default",
                "name": "Name"
            },
            "relative_path_base": "The directory containing profiles.ini",
            "note": "installs.ini may also mark a default profile; it does not restrict the scan."
        },
        "profiles": {
            "scan_all_profiles": true,
            "default_profile_first": true,
            "fallback_root": "~/Library/Application Support/Firefox/Profiles",
            "evidence_files": [
                "prefs.js",
                "user.js"
            ],
            "rule": "Every profile listed in profiles.ini is scanned, not only the default one. Default profiles are read first so the most representative value is reported first, but a non-default profile that carries the preference is still reported."
        },
        "preference_domain": {
            "domain": "org.mozilla.firefox",
            "candidate_roots": [
                "/Library/Managed Preferences",
                "/Library/Managed Preferences/<console_user>",
                "/Library/Preferences",
                "~/Library/Preferences"
            ],
            "file_name_pattern": "<domain>.plist",
            "reader": "/usr/bin/plutil -convert json"
        }
    },

    "evidence_provenance": {
        "rule": "Every collected value records where it came from, so no finding depends on an unstated assumption about which file or profile was read.",
        "required_fields": [
            "channel",
            "scope",
            "source_path",
            "key_path"
        ],
        "bundle_evidence_fields": [
            "bundle_path",
            "bundle_version"
        ],
        "profile_evidence_fields": [
            "profile_name",
            "profile_path",
            "profile_is_default",
            "profile_source",
            "evidence_file"
        ],
        "profile_source_values": [
            "profiles.ini",
            "profiles_directory_scan"
        ],
        "scanned_inventory_fields": [
            "bundles_scanned",
            "profiles_scanned",
            "profiles_ini_path",
            "channels_scanned",
            "channels_unreadable"
        ]
    },

    "pref_mode_notes": {
        "policies_json_shape": "PREF-mode controls are delivered through the Preferences policy: policies.Preferences.<pref_name>.",
        "value_shapes": [
            "Legacy shape: the member is the scalar value itself.",
            "Firefox 81+ shape: the member is an object with Value, Status and Type members; the comparison uses Value and Status='locked' proves enforcement."
        ],
        "requirement": "A collector must accept both shapes before declaring a preference unset."
    },

